# core/fail_safe.py
# フェイルセーフ監視（アラート専用）
# 実挙動を変えず、前兆だけログに残す
# ログがうるさいと感じたら、不要なチェックをコメントアウトで調整
# 異常時は alert_flag を立て、main.pyでCSVに反映

import time
import logging
import psutil
from collections import defaultdict

logger = logging.getLogger("fail_safe")
_counters = defaultdict(int)
_last_loop_time = time.time()

def check_loop_delay(current_time):
    global _last_loop_time
    delay = current_time - _last_loop_time
    if delay > 1200:  # 20分以上
        logger.warning(f"Loop delay exceeded: {delay/60:.1f} min")
        return True
    _last_loop_time = current_time
    return False

def check_memory_usage():
    mem_mb = psutil.Process().memory_info().rss / 1024 / 1024
    if mem_mb > 100:
        logger.warning(f"Memory usage high: {mem_mb:.1f} MB")
        return True
    return False

def check_i2c_error_count(error_occurred: bool):
    if error_occurred:
        _counters["i2c_error"] += 1
        if _counters["i2c_error"] >= 5:
            logger.warning(f"I2C read error consecutive: {_counters['i2c_error']} times")
            return True
    else:
        _counters["i2c_error"] = 0
    return False

def check_ntp_offset(offset):
    if offset is not None and abs(offset) > 60:
        logger.warning(f"NTP offset extreme: {offset:+.3f} seconds")
        return True
    return False

def check_battery_drop(current_pct, prev_pct):
    if prev_pct is not None and prev_pct - current_pct > 20:
        logger.warning(f"Battery sudden drop: -{prev_pct - current_pct}%")
        return True
    return False

def check_send_failure(status):
    if status == -1:
        _counters["send_fail"] += 1
        if _counters["send_fail"] >= 3:
            logger.warning(f"Send failure consecutive: {_counters['send_fail']} times")
            return True
    else:
        _counters["send_fail"] = 0
    return False

def monitor_loop(record, error_occurred=False, prev_batt_pct=None):
    alert = False

    alert |= check_loop_delay(time.time())
    alert |= check_memory_usage()
    alert |= check_i2c_error_count(error_occurred)
    alert |= check_ntp_offset(record.get("ntp_offset"))
    alert |= check_battery_drop(record.get("batt_pct_med"), prev_batt_pct)
    alert |= check_send_failure(record.get("status"))

    return alert
