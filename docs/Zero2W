import time
import smbus2

class SensorManager:
    ADDRESS = 0x76
    I2C_BUS_NUM = 1

    def __init__(self):
        # 補正パラメーター（トリミングデータ）の保持用変数
        self.dig_T = []
        self.dig_P = []
        self.dig_H = []

    def _load_calibration(self, bus):
        """センサー内部の固有補正値を読み出す（初回のみ）"""
        if self.dig_T:  # すでに読み込み済みならスキップ
            return

        # 温度・気圧の補正値（0x88 〜 0xA1）
        cal1 = bus.read_i2c_block_data(self.ADDRESS, 0x88, 26)
        self.dig_T.append((cal1[1] << 8) | cal1[0]) # dig_T1 (unsigned)
        self.dig_T.append(self._to_signed(cal1[3] << 8 | cal1[2]))
        self.dig_T.append(self._to_signed(cal1[5] << 8 | cal1[4]))

        for i in range(1, 10):
            idx = 4 + i * 2
            if i == 1: # dig_P1 (unsigned)
                self.dig_P.append((cal1[idx+1] << 8) | cal1[idx])
            else:
                self.dig_P.append(self._to_signed(cal1[idx+1] << 8 | cal1[idx]))

        # 湿度の補正値（0xA1, 0xE1 〜 0xE7）
        self.dig_H.append(bus.read_byte_data(self.ADDRESS, 0xA1)) # dig_H1
        cal2 = bus.read_i2c_block_data(self.ADDRESS, 0xE1, 7)
        self.dig_H.append(self._to_signed(cal2[1] << 8 | cal2[0])) # dig_H2
        self.dig_H.append(cal2[2]) # dig_H3
        self.dig_H.append(self._to_signed((cal2[3] << 4) | (cal2[4] & 0x0F))) # dig_H4
        self.dig_H.append(self._to_signed((cal2[5] << 4) | (cal2[4] >> 4)))   # dig_H5
        self.dig_H.append(self._to_signed(cal2[6])) # dig_H6

    def _to_signed(self, val, bits=16):
        """補正値を符号付き整数に変換するヘルパー"""
        if val & (1 << (bits - 1)):
            val -= 1 << bits
        return val

    def read_data(self):
        """温湿度・気圧を測定して物理値に変換して返す"""
        try:
            # FOD準拠：リソースリーク防止のため毎回バスを開閉
            bus = smbus2.SMBus(self.I2C_BUS_NUM)
            self._load_calibration(bus)

            # === 🔥 Grok先輩推奨：BME280の湿度センサーを叩き起こす呪文 ===
            # 1. まず湿度設定（ctrl_hum: 0xF2）に 0x01（オーバーサンプリング 1x）を書き込む
            bus.write_byte_data(self.ADDRESS, 0xF2, 0x01)
            
            # 2. 次に温度・気圧設定＋Forced Mode（ctrl_meas: 0xF4）に 0x25 を書き込む
            # これにより、上の0xF2の設定がセンサー内部でカチッと有効化されます
            bus.write_byte_data(self.ADDRESS, 0xF4, 0x25)
            
            # 3. 測定が完全に完了するまで少し長め（100ms）に待つ
            time.sleep(0.1)

            # 4. データブロック（0xF7〜0xFE）の8バイトを一気に読み出す
            data = bus.read_i2c_block_data(self.ADDRESS, 0xF7, 8)
            bus.close() # 読み終えたら即クローズ（固着防止）

            # ビット結合（生データ分解）
            pres_raw = (data[0] << 12) | (data[1] << 4) | (data[2] >> 4)
            temp_raw = (data[3] << 12) | (data[4] << 4) | (data[5] >> 4)
            hum_raw  = (data[6] << 8) | data[7]

            # 3. Bosch公式の補正計算（温度）
            var1 = ((((temp_raw >> 3) - (self.dig_T[0] << 1))) * (self.dig_T[1])) >> 11
            var2 = (((((temp_raw >> 4) - (self.dig_T[0])) * ((temp_raw >> 4) - (self.dig_T[0]))) >> 12) * (self.dig_T[2])) >> 14
            t_fine = var1 + var2
            temperature = float(((t_fine * 5) + 128) >> 8) / 100.0

            # 4. Bosch公式の補正計算（気圧）
            var1 = (t_fine >> 1) - 64000
            var2 = (((var1 >> 2) * (var1 >> 2)) >> 11) * self.dig_P[5]
            var2 = var2 + ((var1 * self.dig_P[4]) << 1)
            var2 = (var2 >> 2) + (self.dig_P[3] << 16)
            var1 = (((self.dig_P[2] * (((var1 >> 2) * (var1 >> 2)) >> 13)) >> 3) + ((self.dig_P[1] * var1) >> 1)) >> 18
            var1 = ((32768 + var1) * self.dig_P[0]) >> 15
            
            if var1 == 0:
                pressure = "NaN"
            else:
                p = (((1048576 - pres_raw) - (var2 >> 12))) * 3125
                if p < 0x80000000:
                    p = (p << 1) // var1
                else:
                    p = (p // var1) * 2
                var1 = (self.dig_P[8] * (((p >> 3) * (p >> 3)) >> 13)) >> 12
                var2 = (((p >> 2)) * self.dig_P[7]) >> 13
                pressure = float(p + ((var1 + var2 + self.dig_P[6]) >> 4)) / 100.0

            # 5. Bosch公式の補正計算（湿度）
            v_x1_u32r = t_fine - 76800
            v_x1_u32r = (((((hum_raw << 14) - (self.dig_H[3] << 20) - (self.dig_H[4] * v_x1_u32r)) + 16384) >> 15) *
                         (((((((v_x1_u32r * self.dig_H[5]) >> 10) * (((v_x1_u32r * self.dig_H[2]) >> 11) + 32768)) >> 10) + 2097152) * self.dig_H[1] + 8192) >> 14))
            v_x1_u32r = v_x1_u32r - (((((v_x1_u32r >> 15) * (v_x1_u32r >> 15)) >> 7) * self.dig_H[0]) >> 4)
            v_x1_u32r = 0 if v_x1_u32r < 0 else v_x1_u32r
            v_x1_u32r = 419430400 if v_x1_u32r > 419430400 else v_x1_u32r
            humidity = float(v_x1_u32r >> 12) / 1024.0

            # 小数点第2位までに丸めて返す
            return round(temperature, 2), round(humidity, 2), round(pressure, 2)

        except Exception:
            return "NaN", "NaN", "NaN"
