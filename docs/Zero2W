import time
from datetime import datetime, timedelta

class ClockManager:
    def get_timestamp(self):
        """FDD仕様：CSVの1列目に記録する標準フォーマットの時刻を返す"""
        return datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    def calc_wait_seconds(self, interval_minutes=15):
        """
        FOD/FDD思想：次の15分境界（00, 15, 30, 45分）までの正確な残り秒数を計算する。
        これにより、間欠運用が15分ジャストのタイミングに完全同期する。
        """
        now = datetime.now()
        
        # 次の境界時間を計算
        minutes_to_add = interval_minutes - (now.minute % interval_minutes)
        next_time = now.replace(second=0, microsecond=0) + timedelta(minutes=minutes_to_add)
        
        # 残り秒数を算出（最低でも1秒は待つ安全弁付き）
        wait_seconds = (next_time - now).total_seconds()
        return max(float(wait_seconds), 1.0)
