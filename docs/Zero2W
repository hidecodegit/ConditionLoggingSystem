import os
import subprocess
import re
import json
from datetime import datetime, timezone, timedelta

# JST強制
JST = timezone(timedelta(hours=9), 'JST')

class StorageManager:
    def __init__(self, ram_dir="/tmp/pipulse", sd_dir="/home/hideo_81_g/sensor_data"):
        """
        4B先輩ハイブリッド仕様：
        15分おきの超高速・省エネ書き込みは ram_dir (/tmp) を使用。
        4時間おきの永続バックアップ先として sd_dir (SDカード) を保持。
        """
        self.ram_dir = ram_dir
        self.sd_dir = sd_dir
        
        os.makedirs(self.ram_dir, exist_ok=True)
        os.makedirs(self.sd_dir, exist_ok=True)

    def _get_ram_monthly_filepath(self):
        """RAM上の今月の全履歴ファイルパスを取得"""
        month_str = datetime.now(JST).strftime("%Y-%m")
        return os.path.join(self.ram_dir, f"pipulse_{month_str}.txt")

    def _get_wifi_rssi(self):
        try:
            res = subprocess.check_output(["iwconfig", "wlan0"], text=True)
            match = re.search(r"Signal level=(-?\d+)\s+dBm", res)
            if match:
                return int(match.group(1))
            return None
        except Exception:
            return None

    def _get_ntp_offset(self):
        try:
            res = subprocess.check_output(["timedatectl", "timesync-status"], text=True, timeout=2)
            match = re.search(r"Offset:\s+([-+]?\d+\.\d+)(ms|s)", res)
            if match:
                val = float(match.group(1))
                unit = match.group(2)
                return val / 1000.0 if unit == "ms" else val
            return 0.0
        except Exception:
            return 0.0

    def flush_ram_to_sd(self):
        """
        自律判定型DataFlusher:
        4時間おき（0時, 4時, 8時, 12時, 16時, 20時の0分〜15分の間）の場合のみ、
        RAM領域のデータをSDカードへrsyncで安全に同期する。
        条件に合わない場合は何もしきせずに False を返す。
        """
        now = datetime.now(JST)
        if not (now.hour % 4 == 0 and 0 <= now.minute < 15):
            return False

        print(f"⏰ 4時間おき（現在 {now.hour}時）のフル同期タイミングに到達しました。")
        print(f"💾 DataFlusher: RAM ({self.ram_dir}) から SDカード ({self.sd_dir}) へ退避中...")
        try:
            subprocess.run(["rsync", "-a", self.ram_dir + "/", self.sd_dir + "/"], check=True)
            print("💾 SDカードへのバックアップ完了！")
            return True
        except Exception as e:
            print(f"❌ SDカードへのバックアップ失敗: {e}")
            return False

    def write_row(self, timestamp, batt_pct, batt_mv, temp, hum, press, status, alert):
        """
        RAM上の月替わりファイルにデータを追記し、そのファイルパスを返す。
        """
        wifi_rssi = self._get_wifi_rssi()
        ntp_offset = self._get_ntp_offset()

        data_dict = {
            "timestamp": str(timestamp),
            "batt_pct": batt_pct if batt_pct != "NaN" else None,
            "batt_mv": batt_mv if batt_mv != "NaN" else None,
            "temp": temp if temp != "NaN" else None,
            "hum": hum if hum != "NaN" else None,
            "press": press if press != "NaN" else None,
            "wifi_rssi": wifi_rssi,
            "ntp_offset": ntp_offset, 
            "status": int(status),
            "alert_flag": 1 if alert else 0
        }

        # 1. RAM上のファイルパスを取得
        ram_monthly_path = self._get_ram_monthly_filepath()

        # 2. RAM上のファイルに追記
        with open(ram_monthly_path, "a", encoding="utf-8") as f:
            f.write(json.dumps(data_dict, ensure_ascii=False) + "\n")
            f.flush()
            os.fsync(f.fileno())
        print(f"📝 RAMへ書き込み完了: {data_dict}")

        return ram_monthly_path
