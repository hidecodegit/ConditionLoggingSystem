import time
import smbus2

class PowerManager:
    MCU_ADDR = 0x57
    REG_BATT_PCT = 0x2a
    
    # 【解析結果】レジスタの仕様に合わせて1バイトずつ明示的にアドレスを指定
    REG_BATT_MV_L = 0x22  # 下位バイト (もし左右逆ならここが上位)
    REG_BATT_MV_H = 0x23  # 上位バイト
    I2C_BUS_NUM = 1

    def get_median_pct(self):
        samples = []
        try:
            bus = smbus2.SMBus(self.I2C_BUS_NUM)
            for _ in range(3):
                val = bus.read_byte_data(self.MCU_ADDR, self.REG_BATT_PCT)
                if 0 <= val <= 100:
                    samples.append(val)
                time.sleep(1)
            bus.close()
            return sorted(samples)[1] if len(samples) >= 3 else (samples[0] if samples else "NaN")
        except Exception:
            return "NaN"

    def get_raw_mv(self):
        """
        【バグ修正版】乱高下する10V単位のバグを修正
        ブロック読み込みを廃止し、エンディアン判定を修正して正しいミリボルトを合成します
        """
        try:
            bus = smbus2.SMBus(self.I2C_BUS_NUM)
            
            # 安全のため1バイトずつ確実に読み出す
            low_byte = bus.read_byte_data(self.MCU_ADDR, self.REG_BATT_MV_L)
            
            # もし0x23が存在する仕様なら読み出す。なければブロックデータの挙動から推測
            try:
                high_byte = bus.read_byte_data(self.MCU_ADDR, self.REG_BATT_MV_H)
            except Exception:
                # 連続読み出ししかできないチップだった場合のフォールバック
                data = bus.read_i2c_block_data(self.MCU_ADDR, self.REG_BATT_MV_L, 2)
                low_byte, high_byte = data[0], data[1]
                
            bus.close()
            
            # 🕵️‍♂️ マスターの解析に基づく「真のビッグエンディアン合成」
            # 固定値だったlow_byte(0x0E)を上位に、変動していたhigh_byteを下位に結合
            mv = (low_byte << 8) | high_byte
            
            # 計算された値が現実的なバッテリー電圧（2500mV〜5000mV）の範囲内かチェック
            if 2500 <= mv <= 5000:
                return mv
            
            # もし元のリトルエンディアンが正しくて、ただの寝起きノイズだった場合の保険
            alternative_mv = (high_byte << 8) | low_byte
            if 2500 <= alternative_mv <= 5000:
                return alternative_mv
                
            return mv # どちらの範囲にも入らない場合はそのまま返す
            
        except Exception:
            return "NaN"
