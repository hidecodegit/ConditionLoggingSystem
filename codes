#!/bin/bash
set -euo pipefail

DB_PATH="/home/hideo_81_g/condition_logging/condition_logging.db"
TARGET_FILE="/dev/shm/sensor_data/latest_temp_humid.txt"
TMP_FILE="${TARGET_FILE}.tmp"
DIR_NAME="$(dirname "$TARGET_FILE")"

mkdir -p "$DIR_NAME"
rm -f "$TMP_FILE"

cleanup() {
  rm -f "$TMP_FILE"
}
trap cleanup EXIT

if [ ! -f "$DB_PATH" ]; then
  echo "show_latest.sh: DB not found: $DB_PATH" >&2
  exit 1
fi

# 1. DBから最新20件を抽出（5秒タイムアウト付き）
sqlite3 -cmd ".timeout 5000" -header -column "$DB_PATH" "
SELECT
  device_id,
  created_at,
  temperature AS temp,
  humidity AS hum,
  pressure AS press,
  battery_voltage AS batt_v,
  battery_percent AS batt_p,
  wifi_rssi AS wifi
FROM (
  SELECT
    device_id,
    created_at,
    temperature,
    humidity,
    NULL AS pressure,
    NULL AS battery_voltage,
    NULL AS battery_percent,
    NULL AS wifi_rssi
  FROM rpi4b_logs
  UNION ALL
  SELECT
    device_id,
    COALESCE(received_at, timestamp) AS created_at,
    temperature,
    humidity,
    pressure,
    battery_voltage,
    battery_percent,
    wifi_rssi
  FROM zero2w_logs
)
ORDER BY created_at DESC
LIMIT 20;
" > "$TMP_FILE"

# 2. 0バイトチェック
if [ ! -s "$TMP_FILE" ]; then
  echo "show_latest.sh: empty output" >&2
  exit 1
fi

# 3. ヘッダーのみ（データ行なし）チェック
line_count="$(wc -l < "$TMP_FILE" | tr -d ' ')"
if [ "$line_count" -lt 2 ]; then
  echo "show_latest.sh: header only or too few lines ($line_count)" >&2
  exit 1
fi

# 4. 安全に置換
mv -f "$TMP_FILE" "$TARGET_FILE"
trap - EXIT
exit 0
